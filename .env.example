# ---------------------------------------------------------------
# NaturaAI - root environment (reference for docker compose / CI)
# Copy to .env and adjust. Secrets are never committed.
# ---------------------------------------------------------------

# PostgreSQL (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=naturaai
POSTGRES_USER=naturaai
POSTGRES_PASSWORD=naturaai

# Backend
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000
FRONTEND_URL=http://localhost:3000
ML_ENGINE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Email (SMTP) - optional. When SMTP_HOST is empty, emails are printed to the
# backend console (dev mode) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@naturaai.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=naturaai
RABBIT_PASS=naturaai

# Qdrant (vector database)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=naturaai-assets

# LLM (choose one provider)
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
LLM_MODEL=meta-llama/Llama-4-17B
